# 环境变量配置示例
# 复制此文件为 .env 并修改相应值

# 服务配置
API_HOST=0.0.0.0
API_PORT=18000
GRADIO_HOST=0.0.0.0
GRADIO_PORT=17000

# 日志配置
LOG_LEVEL=INFO
LOG_DIR=./logs

# 临时文件目录
TMP_DIR=./tmp

# 模型配置
DEFAULT_MODEL=turbo

# 安全配置（生产环境建议设置）
# ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
# API_KEY=your-secret-api-key

# 资源限制
MAX_WORKERS=4
MAX_UPLOAD_SIZE=500M
REQUEST_TIMEOUT=600

# Whisper turbo Worker 与超长音频分块
WHISPER_MODEL=turbo
WHISPER_DEVICE=cuda
WHISPER_DEVICE_INDEX=0
WHISPER_COMPUTE_TYPE=float16
WHISPER_BEAM_SIZE=5
WHISPER_VAD_ENABLED=true
WHISPER_VAD_MIN_SILENCE_MS=2000
WHISPER_MODEL_CACHE_DIR=C:\models\faster-whisper
WHISPER_CHUNK_SECONDS=3600
WHISPER_CHUNK_OVERLAP_SECONDS=10
WHISPER_CHUNK_TIMEOUT_SECONDS=7200
WHISPER_WORKER_START_TIMEOUT_SECONDS=1800
WHISPER_QUEUE_MAX_TASKS=5
WHISPER_MAX_UPLOAD_BYTES=21474836480
WHISPER_MIN_FREE_DISK_GB=20
WHISPER_WORKER_MAX_RSS_GROWTH_MB=2048
WHISPER_AUDIO_LOAD_TIMEOUT=1800


